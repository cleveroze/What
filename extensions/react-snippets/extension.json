  "description": "Quick React building blocks: function components, useState, useEffect and list rendering for JavaScript and TypeScript.",
  "author": "Stride",
  "icon": "clover8",
  "categories": ["Snippets"],
  "contributes": {
    "snippets": [
      { "language": "javascript", "prefix": "rfc", "description": "React function component", "body": ["export default function ${1:Component}() {", "  return (", "    <div>", "      $0", "    </div>", "  );", "}"] },
      { "language": "typescript", "prefix": "rfc", "description": "React function component", "body": ["export default function ${1:Component}() {", "  return (", "    <div>", "      $0", "    </div>", "  );", "}"] },
      { "language": "javascript", "prefix": "us", "description": "useState hook", "body": ["const [${1:value}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:null});"] },
      { "language": "typescript", "prefix": "us", "description": "useState hook", "body": ["const [${1:value}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:null});"] },
      { "language": "javascript", "prefix": "ue", "description": "useEffect hook", "body": ["useEffect(() => {", "  $0", "}, [${1}]);"] },
      { "language": "typescript", "prefix": "ue", "description": "useEffect hook", "body": ["useEffect(() => {", "  $0", "}, [${1}]);"] },
      { "language": "javascript", "prefix": "map", "description": "Render a list", "body": ["{${1:items}.map((${2:item}) => (", "  <li key={${2:item}.id}>{${2:item}.${3:name}}</li>", "))}"] },
      { "language": "typescript", "prefix": "map", "description": "Render a list", "body": ["{${1:items}.map((${2:item}) => (", "  <li key={${2:item}.id}>{${2:item}.${3:name}}</li>", "))}"] }
    ]
  }
